# ------------------------------
# API Server Configuration
# ------------------------------
# The URL where your Lollms instance is running (for translation)
LOLLMS_URL=https://localhost:9642
LOLLMS_API_KEY=""
LOLLMS_VERIFY_SSL_CERTIFICATE=false
LOLLMS_MODEL_NAME="Kimi-K 2.5"
CERTIFICATE_FILE_PATH=""

# Port and Host for the Video Translation Server
# (Note: You may need to update the __main__ block in server.py to read these if not using a process manager)
PORT=8000
HOST=0.0.0.0

# ------------------------------
# Model Storage & GPU
# ------------------------------
# Directory where Whisper and F5-TTS models will be downloaded.
# Useful to prevent filling up your primary disk.
HF_HOME=./model_cache

# GPU Selection
# Set to "0" for the first GPU, "0,1" for multiple, or empty for default.
# Use "-1" to force CPU (Not recommended for F5-TTS).
CUDA_VISIBLE_DEVICES=0

# ------------------------------
# App Directories (Optional overrides)
# ------------------------------
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
